        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.model_selection import train_test_split, RandomizedSearchCV\n",
        "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
        "from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier, AdaBoostClassifier, StackingClassifier\n",
        "from xgboost import XGBClassifier\n",
        "from sklearn.metrics import accuracy_score, classification_report\n",
        "from sklearn.feature_selection import SelectKBest, f_classif\n",
        "from imblearn.over_sampling import SMOTE\n",
        "import lightgbm as lgb\n",
        "import scipy.stats as stats\n",
        "from sklearn.svm import SVC\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "\n",
        "df = pd.read_csv('/content/WA_Fn-UseC_-HR-Employee-Attrition.csv')\n",
        "\n",
        "df = df.ffill()\n",
        "\n",
        "\n",
        "le = LabelEncoder()\n",
        "df = df.apply(lambda col: le.fit_transform(col) if col.dtype == 'object' else col)\n",
        "\n",
        "df['Attrition'] = df['Attrition'].astype('int')\n",
        "\n",
        "X = df.drop('Attrition', axis=1)\n",
        "y = df['Attrition']\n",
        "\n",
        "numerical_columns = X.select_dtypes(include=[np.number]).columns\n",
        "scaler = StandardScaler()\n",
        "X[numerical_columns] = scaler.fit_transform(X[numerical_columns])\n",
        "\n",
        "fisher_selector = SelectKBest(score_func=f_classif, k='all')\n",
        "fisher_selector.fit(X, y)\n",
        "fisher_scores = fisher_selector.scores_\n",
        "\n",
        "corr_scores = [stats.pearsonr(X[col], y)[0] for col in X.columns]\n",
        "\n",
        "def dispersion_ratio(X, y, feature):\n",
        "    attrition_1 = X[feature][y == 1]\n",
        "    attrition_0 = X[feature][y == 0]\n",
        "    return np.std(attrition_1) / (np.std(attrition_0) + 1e-10)\n",
        "\n",
        "dispersion_scores = [dispersion_ratio(X, y, feature) for feature in X.columns]\n",
        "\n",
        "\n",
        "feature_ranking = pd.DataFrame({\n",
        "    'Feature': X.columns,\n",
        "    'Fisher_Score': fisher_scores,\n",
        "    'Correlation_Coefficient': np.abs(corr_scores),\n",
        "    'Dispersion_Ratio': dispersion_scores\n",
        "})\n",
        "\n",
        "feature_ranking['Fisher_Score'] = feature_ranking['Fisher_Score'] / feature_ranking['Fisher_Score'].max()\n",
        "feature_ranking['Correlation_Coefficient'] = feature_ranking['Correlation_Coefficient'] / feature_ranking['Correlation_Coefficient'].max()\n",
        "feature_ranking['Dispersion_Ratio'] = feature_ranking['Dispersion_Ratio'] / feature_ranking['Dispersion_Ratio'].max()\n",
        "\n",
        "\n",
        "feature_ranking['Combined_Score'] = (0.7 * feature_ranking['Fisher_Score'] + 0.6 * feature_ranking['Correlation_Coefficient'] + 0.7 * feature_ranking['Dispersion_Ratio'])\n",
        "\n",
        "threshold = 0.6\n",
        "\n",
        "top_features = feature_ranking[feature_ranking['Combined_Score'] > threshold]['Feature']\n",
        "X_selected = X[top_features]\n",
        "\n",
        "smote = SMOTE(random_state=42)\n",
        "X_resampled, y_resampled = smote.fit_resample(X_selected, y)\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(X_resampled, y_resampled, test_size=0.2, random_state=42)\n",
        "\n",
        "rf_param_grid = {\n",
        "    'n_estimators': [100, 200, 300],\n",
        "    'max_depth': [10, 20, 30],\n",
        "    'min_samples_split': [2, 5],\n",
        "    'min_samples_leaf': [1, 2]\n",
        "}\n",
        "\n",
        "gb_param_grid = {\n",
        "    'n_estimators': [100, 200],\n",
        "    'learning_rate': [0.01, 0.1],\n",
        "    'max_depth': [3, 5, 7],\n",
        "    'subsample': [0.8, 1.0]\n",
        "}\n",
        "\n",
        "def tune_model(model, param_grid):\n",
        "    search = RandomizedSearchCV(model, param_grid, n_iter=10, scoring='accuracy', cv=5, verbose=1, random_state=42, n_jobs=-1)\n",
        "    search.fit(X_train, y_train)\n",
        "    return search.best_estimator_\n",
        "\n",
        "rf_model = tune_model(RandomForestClassifier(random_state=42), rf_param_grid)\n",
        "gb_model = tune_model(GradientBoostingClassifier(random_state=42), gb_param_grid)\n",
        "ada_model = AdaBoostClassifier(n_estimators=100, learning_rate=1.0, random_state=42)\n",
        "\n",
        "rf_model.fit(X_train, y_train)\n",
        "gb_model.fit(X_train, y_train)\n",
        "ada_model.fit(X_train, y_train)\n",
        "\n",
        "rf_pred = rf_model.predict(X_test)\n",
        "gb_pred = gb_model.predict(X_test)\n",
        "ada_pred = ada_model.predict(X_test)\n",
        "\n",
        "accuracy_rf = accuracy_score(y_test, rf_pred)\n",
        "accuracy_gb = accuracy_score(y_test, gb_pred)\n",
        "accuracy_ada = accuracy_score(y_test, ada_pred)\n",
        "\n",
        "print(\"Random Forest Accuracy:\",accuracy_rf)\n",
        "print(classification_report(y_test, rf_pred))\n",
        "\n",
        "print(\"Gradient Boosting Accuracy:\", accuracy_gb)\n",
        "print(classification_report(y_test, gb_pred))\n",
        "\n",
        "print(\"AdaBoost Accuracy:\", accuracy_ada)\n",
        "print(classification_report(y_test, ada_pred))\n",
        "\n",
        "estimators = [\n",
        "    ('rf', rf_model),\n",
        "    ('gb', gb_model),\n",
        "    ('ada', ada_model)\n",
        "]\n",
        "\n",
        "stacking_model = StackingClassifier(estimators=estimators, final_estimator=RandomForestClassifier())\n",
        "stacking_model.fit(X_train, y_train)\n",
        "\n",
        "stacking_pred = stacking_model.predict(X_test)\n",
        "accuracy_stacking = accuracy_score(y_test, stacking_pred)\n",
        "\n",
        "print(\"Stacking Accuracy:\", accuracy_stacking)\n",
        "print(classification_report(y_test, stacking_pred))\n",
        "\n",
        "print(\"Best Performing model:\")\n",
        "best_model = max((accuracy_rf, 'Random Forest'),\n",
        "                 (accuracy_gb, 'Gradient Boosting'),\n",
        "                 (accuracy_ada, 'AdaBoost'),\n",
        "                 (accuracy_stacking, 'Stacking'),\n",
        "                 key=lambda x: x[0])\n",
        "\n",
        "print(best_model[1],\"performs better.\")"
      ]
